{
  "name": "@accordiq/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "echo \"@accordiq/db is consumed as source; nothing to build\"",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "push": "drizzle-kit push"
  },
  "dependencies": {
    "@accordiq/core": "workspace:*",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "vitest": "^4.1.0"
  }
}
