# AccordIQ environment template — placeholders only. Copy to .env.local (or apps/web/.env.local)
# and fill in. NEVER commit real secrets. Names and constraints: docs/deployment.md.
# Production runtime refuses SQLite, local disk, console email, fixture LLM, sandbox e-sign,
# and the development AUTH_SECRET. PostgreSQL and S3 are not wired.

NODE_ENV=development
APP_URL=http://localhost:3000

# Local development uses SQLite. Production target remains PostgreSQL.
DATABASE_URL=file:.data/accordiq.sqlite

# Required in production. Must be at least 32 characters and must not be the development placeholder.
# Also wraps organization CRM/ERP credentials (AES-256-GCM). Server-side only.
# AUTH_SECRET=

# Development mailer writes reset URLs and notification mail to .data/mail-outbox.jsonl
# Console is test-only. It is not a live email provider and is refused in production.
EMAIL_DRIVER=console
EMAIL_FROM=AccordIQ <noreply@localhost>

# Production password reset (required when NODE_ENV=production)
# EMAIL_DRIVER=resend
# RESEND_API_KEY=
# EMAIL_FROM=AccordIQ <noreply@your-domain.example>

# Optional override for the development seed password (min 10 characters)
# AUTH_SEED_PASSWORD=Dev-only-passw0rd!

# Document storage: "local" (dev) or "s3" (production)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.data/uploads

# AI provider: none | fixture | openai | anthropic
# none = setup path only (default). Does not invent extractions.
# fixture = labeled samples that contain ACCORDIQ_FIXTURE:... (not a live model; refused in production)
# openai / anthropic require LLM_API_KEY
LLM_PROVIDER=none
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_MS=30000

# E-signature: none | sandbox | dropbox_sign
# none = setup path only (default). Does not invent signed status.
# sandbox = test-only HMAC webhook pipeline. Not legally binding. Refused in production.
# dropbox_sign requires ESIGN_API_KEY and ESIGN_WEBHOOK_SECRET (server-side only).
ESIGN_PROVIDER=none
# ESIGN_API_KEY=
# ESIGN_WEBHOOK_SECRET=
# ESIGN_WEBHOOK_TOLERANCE_SECONDS=300
# ESIGN_TEST_MODE=true

# Synthetic overview figures. Ignored in production. Leave unset for honest empty states.
# NEXT_PUBLIC_DEMO_DATA=true
